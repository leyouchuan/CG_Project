# Simple Snow-Covered Pine Tree
# Created for winter forest environment

mtllib pine_tree.mtl

# Vertices (scaled for winter scene)
v 0.0 2.0 0.0      # Top tip
v -0.2 1.6 0.2     # Upper layer 1
v 0.2 1.6 0.2
v 0.2 1.6 -0.2
v -0.2 1.6 -0.2

v -0.3 1.2 0.3     # Middle layer 1
v 0.3 1.2 0.3
v 0.3 1.2 -0.3
v -0.3 1.2 -0.3

v -0.4 0.8 0.4     # Middle layer 2
v 0.4 0.8 0.4
v 0.4 0.8 -0.4
v -0.4 0.8 -0.4

v -0.5 0.4 0.5     # Bottom layer
v 0.5 0.4 0.5
v 0.5 0.4 -0.5
v -0.5 0.4 -0.5

v -0.2 0.0 0.2     # Trunk top
v 0.2 0.0 0.2
v 0.2 0.0 -0.2
v -0.2 0.0 -0.2

v -0.15 -0.6 0.15  # Trunk base
v 0.15 -0.6 0.15
v 0.15 -0.6 -0.15
v -0.15 -0.6 -0.15

# Texture coordinates
vt 0.0 0.0
vt 1.0 0.0
vt 0.5 1.0
vt 0.0 1.0
vt 1.0 1.0

# Normals
vn 0.0 1.0 0.0
vn 0.0 0.0 1.0
vn 1.0 0.0 0.0
vn 0.0 0.0 -1.0
vn -1.0 0.0 0.0

# Trunk material
usemtl trunk
# Trunk faces
f 21/1/1 22/2/2 26/3/3 25/4/4
f 22/1/2 23/2/3 27/3/4 26/4/5
f 23/1/3 24/2/4 28/3/1 27/4/2
f 24/1/4 21/2/1 25/3/2 28/4/3

# Snow-covered branches material
usemtl snow_branches
# Upper layer (snow covered)
f 1/1/1 2/2/2 3/3/3
f 1/1/1 3/2/3 4/3/4
f 1/1/1 4/2/4 5/3/5
f 1/1/1 5/2/5 2/3/2

# Middle layer 1
f 2/1/2 6/2/3 7/3/4 3/4/5
f 3/1/3 7/2/4 8/3/1 4/4/2
f 4/1/4 8/2/1 9/3/2 5/4/3
f 5/1/5 9/2/2 6/3/3 2/4/4

# Middle layer 2
f 6/1/3 10/2/4 11/3/1 7/4/2
f 7/1/4 11/2/1 12/3/2 8/4/3
f 8/1/1 12/2/2 13/3/3 9/4/4
f 9/1/2 13/2/3 10/3/4 6/4/5

# Bottom layer
f 10/1/4 14/2/1 15/3/2 11/4/3
f 11/1/1 15/2/2 16/3/3 12/4/4
f 12/1/2 16/2/3 17/3/4 13/4/5
f 13/1/3 17/2/4 14/3/5 10/4/1